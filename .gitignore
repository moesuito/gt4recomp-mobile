# Local game data, BIOS, captures, and derivative output.
/private/
/generated/
*.iso
*.ISO
*.chd
*.cso
# Disc patches (Spec II xdelta and similar): they carry game and mod data.
*.xdelta
*.xdelta3
*.vcdiff
*.ppf
*.bps
CORE.GT4
*.elf
*.ELF

# Build products and local editor configuration.
/build/
/build-*/
/out/
/.vs/
CMakeUserPresets.json
__pycache__/
*.pyc
# Launcher build output (Rust workspace).
/launcher/target/
# Tauri build outputs (generated by cargo build of gt4l-tauri)
/launcher/crates/gt4l-tauri/gen/*
# TASK-180: the Android app project is source (its build output is ignored by gen/android/.gitignore).
!/launcher/crates/gt4l-tauri/gen/android/
/launcher/crates/gt4l-tauri/permissions/autogenerated/

# Owner's community patch (never committed).
*.xdelta

# Private ARMSX2 GS test build: the resources copied out of the vendored ARMSX2 tree into the APK assets are GPL data,
# staged by android/stage-armsx2gs.cmd and never committed.
/launcher/crates/gt4l-tauri/gen/android/app/src/main/assets/armsx2gs/

# Shader compiler dependencies of the imported ARMSX2 shaderc, fetched by tools/fetch_armsx2_shader_deps.py at the
# revisions shaderc's DEPS pins. Large third-party histories; never committed.
/third_party/armsx2/platforms/android/app/src/main/cpp/3rdparty/shaderc/third_party/glslang/
/third_party/armsx2/platforms/android/app/src/main/cpp/3rdparty/shaderc/third_party/spirv-headers/
/third_party/armsx2/platforms/android/app/src/main/cpp/3rdparty/shaderc/third_party/spirv-tools/
