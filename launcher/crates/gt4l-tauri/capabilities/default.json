{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The launcher window may listen to the launcher's own events and call only the launcher's commands. No shell, no file system access from the page: pickers run in Rust.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-state",
    "allow-get-settings-table",
    "allow-set-setting",
    "allow-reset-gs-settings-to-defaults",
    "allow-gsdx-download-needed",
    "allow-download-gsdx",
    "allow-install-gsdx-archive",
    "allow-coregs20-offer",
    "allow-use-coregs20",
    "allow-setup-choose-disc",
    "allow-setup-start",
    "allow-setup-cancel",
    "allow-play",
    "allow-resume-game",
    "allow-first-start-hint",
    "allow-stop-game",
    "allow-prepare-shaders",
    "allow-cancel-shader-prepare",
    "allow-saves-list",
    "allow-saves-import",
    "allow-saves-activate",
    "allow-saves-delete",
    "allow-saves-new",
    "allow-saves-export",
    "allow-saves-rename",
    "allow-replays-list",
    "allow-replays-import",
    "allow-replays-delete",
    "allow-get-controls",
    "allow-pad-status",
    "allow-capture-binding",
    "allow-cancel-capture",
    "allow-reset-binding",
    "allow-assign-binding",
    "allow-reset-all-bindings",
    "allow-get-virtual-pad",
    "allow-save-virtual-pad",
    "allow-reset-virtual-pad",
    "allow-get-wheel-config",
    "allow-set-wheel-setting",
    "allow-apply-wheel-preset",
    "allow-assign-wheel-binding",
    "allow-reset-wheel-binding",
    "allow-reset-wheel-config",
    "allow-capture-wheel-binding",
    "allow-cancel-wheel-capture",
    "allow-test-wheel-ffb",
    "allow-wheel-watch",
    "allow-get-wheel-session-check",
    "allow-list-wheel-presets",
    "allow-save-wheel-preset",
    "allow-delete-wheel-preset",
    "allow-about-info",
    "allow-release-notes",
    "allow-open-link",
    "allow-open-log-folder",
    "allow-open-latest-log",
    "allow-export-logs",
    "allow-open-export-folder",
    "allow-open-game-files-folder",
    "allow-open-player-folder",
    "allow-open-saves-folder",
    "allow-open-replays-folder",
    "allow-open-textures-folder",
    "allow-textures-state",
    "allow-choose-textures-folder",
    "allow-reset-textures-folder",
    "allow-games-list",
    "allow-select-game",
    "allow-games-remove",
    "allow-check-updates",
    "allow-list-launcher-versions",
    "allow-install-launcher-version",
    "allow-apply-update",
    "allow-skip-update",
    "allow-confirm-close",
    "allow-ui-ready",
    "allow-ui-log",
    "allow-ra-status",
    "allow-ra-login",
    "allow-ra-logout",
    "allow-ra-set-options"
  ]
}
